# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Code generation (freezed/json_serializable) — regenerated via
# `dart run build_runner build`, see README setup steps.
**/*.freezed.dart
**/*.g.dart

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/coverage/

# Secrets — .env holds the Google Cloud API key and must never be committed.
# .env.example documents the keys without their values.
.env
.env.*
!.env.example

# Play Store release signing key — losing control of this or committing it
# would mean either leaking the app's signing identity or being unable to
# ever update the app on the Play Store again.
android/key.properties
*.jks
*.keystore

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
