rules_version = '2';

// The client never talks to Firestore directly — otpCodes is only ever read
// or written by the Cloud Functions (via the Admin SDK, which bypasses these
// rules entirely). Deny all direct client access as a safety net.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
