# Copy this file to .env for local `vercel dev` testing. In production, set
# these as Environment Variables in the Vercel dashboard instead — never
# commit a real .env file.

# From Firebase Console -> Project settings -> Service accounts -> Generate
# new private key. Paste the ENTIRE downloaded JSON file's contents here as
# one single-line value (most tools/shells will keep it valid JSON even
# across a multi-line paste, but if yours doesn't, minify it to one line).
FIREBASE_SERVICE_ACCOUNT_KEY=

# From the Twilio Console dashboard, and the WhatsApp sandbox/sender number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
